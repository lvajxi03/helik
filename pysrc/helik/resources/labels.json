                "rotate": 0,
                "color": "#ffffff"
            },
            "help-S2": {
                "label": "There are two music sets available:",
                "font": "pages-small",
                "rotate": 0,
                "color": "#ffffff"
            },
            "help-S3": {
                "label": "* background music set for all the menus and info boards,",
                "font": "pages-small",
                "rotate": 0,
                "color": "#ffffff"
            },
            "help-S4": {
                "label": "* game play music set",
                "font": "pages-small",
                "rotate": 0,
                "color": "#ffffff"
